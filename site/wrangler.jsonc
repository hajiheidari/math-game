// Cloudflare Worker for adadi.espadna.com and the espadna.com/adadi-app* route, like Tiaro's
// crowns-app Worker. Deployed by .github/workflows/site.yml after site/build.sh; never deploy by
// hand. Static assets (the game is a single page: unknown paths get its index.html) plus the
// friend-hints API in worker.js (/api/*, one Durable Object with SQLite per player).
{
  "name": "adadi",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "../dist-site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "REFERRALS", "class_name": "Referrals" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Referrals"] }],
  "routes": [
    { "pattern": "adadi.espadna.com", "custom_domain": true },
    { "pattern": "espadna.com/adadi-app*", "zone_name": "espadna.com" }
  ]
}
